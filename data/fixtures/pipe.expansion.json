    {"id": "temperature-pair", "input": {"method": "linear_expansion", "length_m": 10, "initial_c": 20, "final_c": 70, "alpha_mm_m_k": 0.15, "alpha_source": "Учебное значение"}, "expected": {"status": "ready", "values": {"expansion_mm": 75}}},
