    {"id": "zero-alpha", "input": {"method": "linear_expansion", "length_m": 10, "temperature_change_k": 50, "alpha_mm_m_k": 0, "alpha_source": "Учебное значение"}, "expected": {"status": "ready", "values": {"expansion_mm": 0}}},
